# 9Router Local Lab Environment Configuration
# Copy this file to .env before starting

# Port configuration
PORT=20128

# Data directory for SQLite & config storage
DATA_DIR=./data

# Environment mode
NODE_ENV=production

# 9Router Generated Gateway Key (Generated via Dashboard > API Keys)
# ROUTER_API_KEY=your_generated_gateway_api_key_here

# Client Environment Exports Reference (Do not commit real keys!)
# ANTHROPIC_BASE_URL=http://localhost:20128/v1
# ANTHROPIC_AUTH_TOKEN=your_generated_gateway_api_key_here
# ANTHROPIC_MODEL=claude-virtually-unlimited
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# ---------------------------------------------------------------------------
# Production deployment only (docker-compose.prod.yml) — all REQUIRED,
# no weak defaults are provided. Generate strong random values, e.g.
# `openssl rand -base64 24`.
# ---------------------------------------------------------------------------
# DOMAIN=ai.yourdomain.com
# INITIAL_PASSWORD=
# POSTGRES_DB=sendago_gateway
# POSTGRES_USER=sendago_admin
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# DATABASE_URL=
